#: qml/Main.qml:139
msgid ""
"Multi-light needs access to the camera to switch the flashlight. Allow it in "
"System Settings, then come back. If it still does not work, restart the "
"phone."
msgstr ""
"Multi-light necesita acceso a la cámara para encender la linterna. Permítelo "
"en Configuración del sistema y vuelve. Si sigue sin funcionar, reinicia el "
"teléfono."

#: qml/Main.qml:143
msgid "Open settings"
msgstr "Abrir configuración"

#. TRANSLATORS: big on/off button, keep it short
#: qml/Main.qml:165
msgid "ON"
msgstr "ENCENDIDA"

#: qml/Main.qml:165
msgid "OFF"
msgstr "APAGADA"

#. TRANSLATORS: %1 = blinks per second, shown under ON/OFF
#: qml/Main.qml:174
msgid "blink %1/s"
msgstr "parpadeo %1/s"

#: qml/Main.qml:189
msgid "Stop SOS"
msgstr "Detener SOS"

#: qml/Main.qml:189
msgid "SOS"
msgstr "SOS"

#: qml/Main.qml:198
msgid "Screen light"
msgstr "Luz de pantalla"

#. TRANSLATORS: %1 = number of blinks per second
#: qml/Main.qml:213
msgid "Flashlight blink: %1 per second"
msgstr "Parpadeo de la linterna: %1 por segundo"

#: qml/Main.qml:214
msgid "Flashlight blink: off"
msgstr "Parpadeo de la linterna: desactivado"

#. TRANSLATORS: slider value when blinking is off
#: qml/Main.qml:224
msgid "off"
msgstr "desactivado"

#: qml/Main.qml:246
msgid "Tap to close"
msgstr "Toca para cerrar"
