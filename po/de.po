#: qml/Main.qml:165
msgid "ON"
msgstr "AN"

#: qml/Main.qml:165
msgid "OFF"
msgstr "AUS"

#. TRANSLATORS: %1 = blinks per second, shown under ON/OFF
#: qml/Main.qml:174
msgid "blink %1/s"
msgstr "Blinken %1/s"

#: qml/Main.qml:189
msgid "Stop SOS"
msgstr "SOS beenden"

#: qml/Main.qml:189
msgid "SOS"
msgstr "SOS"

#: qml/Main.qml:198
