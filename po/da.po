#: qml/Main.qml:138
msgid ""
"Multi-light needs access to the camera to switch the flashlight. Allow it in "
"System Settings, then come back. If it still does not work, restart the "
"phone."
msgstr "Multi-light skal have adgang til kameraet for at tænde lommelygten. Giv adgang i Systemindstillinger, og kom så tilbage. Virker det stadig ikke, så genstart telefonen."

#: qml/Main.qml:142
msgid "Open settings"
msgstr "Åbn indstillinger"

#. TRANSLATORS: big on/off button, keep it short
#: qml/Main.qml:164
msgid "ON"
msgstr "TIL"

#: qml/Main.qml:164
msgid "OFF"
msgstr "FRA"

#. TRANSLATORS: %1 = blinks per second, shown under ON/OFF
#: qml/Main.qml:173
msgid "blink %1/s"
msgstr "blink %1/s"

#: qml/Main.qml:188
msgid "Stop SOS"
msgstr "Stop SOS"

#: qml/Main.qml:188
msgid "SOS"
msgstr "SOS"

#: qml/Main.qml:197
msgid "Screen light"
msgstr "Skærmlys"

#. TRANSLATORS: %1 = number of blinks per second
#: qml/Main.qml:212
msgid "Flashlight blink: %1 per second"
msgstr "Lommelygten blinker: %1 pr. sekund"

#: qml/Main.qml:213
msgid "Flashlight blink: off"
msgstr "Lommelygten blinker: fra"

#. TRANSLATORS: slider value when blinking is off
#: qml/Main.qml:223
msgid "off"
msgstr "fra"

#: qml/Main.qml:245
msgid "Tap to close"
msgstr "Tryk for at lukke"
