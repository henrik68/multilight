#: qml/Main.qml:139
msgid ""
"Multi-light needs access to the camera to switch the flashlight. Allow it in "
"System Settings, then come back. If it still does not work, restart the "
"phone."
msgstr ""
"Multi-light heeft toegang tot de camera nodig om de zaklamp te schakelen. "
"Sta dit toe in Systeeminstellingen en kom dan terug. Werkt het nog steeds "
"niet, herstart dan de telefoon."

#: qml/Main.qml:143
msgid "Open settings"
msgstr "Instellingen openen"

#. TRANSLATORS: big on/off button, keep it short
#: qml/Main.qml:165
msgid "ON"
msgstr "AAN"

#: qml/Main.qml:165
msgid "OFF"
msgstr "UIT"

#. TRANSLATORS: %1 = blinks per second, shown under ON/OFF
#: qml/Main.qml:174
msgid "blink %1/s"
msgstr "knipperen %1/s"

#: qml/Main.qml:189
msgid "Stop SOS"
msgstr "SOS stoppen"

#: qml/Main.qml:189
msgid "SOS"
msgstr "SOS"

#: qml/Main.qml:198
msgid "Screen light"
msgstr "Schermlicht"

#. TRANSLATORS: %1 = number of blinks per second
#: qml/Main.qml:213
msgid "Flashlight blink: %1 per second"
msgstr "Zaklamp knippert: %1 per seconde"

#: qml/Main.qml:214
msgid "Flashlight blink: off"
msgstr "Zaklamp knippert: uit"

#. TRANSLATORS: slider value when blinking is off
#: qml/Main.qml:224
msgid "off"
msgstr "uit"

#: qml/Main.qml:246
msgid "Tap to close"
msgstr "Tik om te sluiten"
